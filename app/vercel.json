{
          "buildCommand": "npm install && npm run build",
          "outputDirectory": "dist",
          "installCommand": "npm install",
          "framework": "vite",
          "redirects": [
                      {
                                    "source": "/:path*",
                                    "has": [{ "type": "host", "value": "studiocostanzopagano.it" }],
                                    "destination": "https://www.studiocostanzopagano.it/:path*",
                                    "permanent": true
                      }
          ],
          "rewrites": [
                      { "source": "/api/send-email", "destination": "/src/routes/send-email.ts" },
                      { "source": "/(.*)", "destination": "/index.html" }
          ]
}
